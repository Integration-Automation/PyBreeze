{
 "about": "An AutoControl script under its own key: a list of values too long, a parameter left out.",
 "frameworks": [
  "je_auto_control"
 ],
 "exchange": [
  {
   "send": {
    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
     "textDocument": {
      "uri": "file:///project/script.json",
      "languageId": "json",
      "version": 1,
      "text": "{\n  \"auto_control\": [\n    [\"AC_set_mouse_position\", [100, 200, 300]],\n    [\"AC_click_mouse\", {\"mouse_keycode\": \"mouse_left\", \"x\": 100}],\n    [\"AC_write\", {}]\n  ]\n}\n"
     }
    }
   },
   "expect": [
    {
     "jsonrpc": "2.0",
     "method": "textDocument/publishDiagnostics",
     "params": {
      "uri": "file:///project/script.json",
      "version": 1,
      "diagnostics": [
       {
        "range": {
         "start": {
          "line": 2,
          "character": 41
         },
         "end": {
          "line": 2,
          "character": 44
         }
        },
        "severity": 1,
        "code": "too-many-values",
        "source": "je_auto_control",
        "message": "AC_set_mouse_position takes at most 2 values in a list, and this one gives 3"
       },
       {
        "range": {
         "start": {
          "line": 4,
          "character": 5
         },
         "end": {
          "line": 4,
          "character": 15
         }
        },
        "severity": 1,
        "code": "missing-parameter",
        "source": "je_auto_control",
        "message": "AC_write needs write_string"
       }
      ]
     }
    }
   ]
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": 11,
    "method": "textDocument/completion",
    "params": {
